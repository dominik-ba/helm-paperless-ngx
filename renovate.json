{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track paperless-ngx Docker image tag via appVersion renovate comment in Chart.yaml",
      "fileMatch": ["^Chart\\.yaml$"],
      "matchStrings": [
        "# renovate: depName=(?<depName>[^\\s]+)\\s+(?:registryUrl=(?<registryUrl>[^\\s]+)\\s+)?datasource=(?<datasource>[^\\s]+)\\nappVersion: \"(?<currentValue>[^\"]+)\""
      ]
    },
    {
      "customType": "regex",
      "description": "Track docker images hardcoded in Helm template files",
      "fileMatch": ["^templates/.*\\.ya?ml$"],
      "matchStrings": [
        "image: (?<depName>[a-z0-9./]+):(?<currentValue>[a-z0-9._-]+)"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Bump the chart version with every subchart or image update, so main always holds a releasable version (release.yml publishes it)",
      "matchManagers": ["helmv3", "helm-values"],
      "bumpVersion": "patch"
    },
    {
      "matchUpdateTypes": ["major"],
      "assignees": ["dominik-ba"]
    },
    {
      "matchUpdateTypes": ["minor"],
      "automerge": true,
      "minimumReleaseAge": "5 days"
    },
    {
      "matchUpdateTypes": ["patch"],
      "automerge": true
    }
  ]
}
